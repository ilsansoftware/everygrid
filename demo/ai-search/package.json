  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1170.0",
    "esbuild": "^0.25.0"
  }
}
